<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ProjekAkhir" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Kustomisasi tema dengan warna kita -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>

        <!-- Override warna tombol Material3 -->
        <item name="colorPrimaryContainer">@color/primary</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondaryContainer">@color/white</item>
        <item name="colorOnSecondaryContainer">@color/primary</item>
    </style>

    <style name="Theme.ProjekAkhir" parent="Base.Theme.ProjekAkhir" />
</resources>